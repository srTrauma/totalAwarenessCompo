# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=dsyhlvmwk
CLOUDINARY_API_KEY=717745483365234
CLOUDINARY_API_SECRET=your_api_secret_here

# Nota: Reemplaza 'your_api_secret_here' con tu API Secret real de Cloudinary
