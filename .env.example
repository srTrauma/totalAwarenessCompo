# Base de datos
DATABASE_URL="file:./dev.db"

# Cloudinary (necesario para producción en Render)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Email Configuration (para reset de contraseñas)
# Configuración recomendada para Gmail:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-contraseña-de-aplicacion

# Otras opciones de proveedores de email:
# Outlook:
# EMAIL_HOST=smtp.outlook.com
# EMAIL_PORT=587

# Yahoo:
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587

# Zoho:
# EMAIL_HOST=smtp.zoho.com
# EMAIL_PORT=587

# URL base de la aplicación (cambiar en producción)
NEXTAUTH_URL=http://localhost:3000

# Instrucciones para Gmail:
# 1. Habilita la verificación en 2 pasos en tu cuenta de Google
# 2. Ve a "Contraseñas de aplicaciones" en tu cuenta de Google
# 3. Genera una nueva contraseña de aplicación para "Correo"
# 4. Usa esa contraseña generada en EMAIL_PASS (no tu contraseña normal)
